# Chave da API da Anthropic (https://console.anthropic.com). Obrigatória.
ANTHROPIC_API_KEY=

# Modelo usado nas respostas. Padrão: claude-opus-5-5.
# Opção mais barata para volume alto: claude-haiku-5-5 (sem fallback no servidor).
DONA_NORMA_MODELO=claude-opus-5-5

# Esforço de raciocínio: low | medium | high | xhigh | max. Para perguntas curtas, low costuma bastar.
DONA_NORMA_ESFORCO=low

# Limite de tokens de saída por resposta (inclui o raciocínio interno).
DONA_NORMA_MAX_TOKENS=4000

# Link do convite que aparece quando a pergunta depende dos dados da empresa.
DONA_NORMA_CTA_URL=https://wavern.com.br

# true (ou 1, sim, yes) = recusa iniciar se algum documento da base-legal não tiver "verificado_em".
# Deixe true em produção.
DONA_NORMA_EXIGIR_BASE_VERIFICADA=false

# Fração mínima (0 a 1) do texto da resposta que precisa estar coberta por citações da base.
# Abaixo disso, a resposta vira encaminhamento ao contador. Calibre com npm run avaliar.
DONA_NORMA_COBERTURA_MINIMA=0.35

# Servidor HTTP (npm run servidor)
DONA_NORMA_PORTA=8787
# Origens liberadas no CORS (sites que embutem a Dona Norma), separadas por vírgula. Use * só em teste.
DONA_NORMA_CORS_ORIGEM=https://wavern.com.br
# Perguntas por IP por hora (proteção da versão gratuita).
DONA_NORMA_LIMITE_POR_HORA=20
# true só se o servidor estiver atrás de um proxy (nginx, Vercel, Cloudflare): o limite passa a usar
# o último IP do X-Forwarded-For. Sem proxy, deixe false (o cabeçalho poderia ser forjado).
DONA_NORMA_CONFIAR_PROXY=false
